JOBS := $(shell nproc)
PUID := $(shell id -u)
PGID := $(shell id -g)

OUTPUT = build/$(EXE)
TEST_OUTPUT = build/sdx2_quality_test
TEST_SRCS = tests/sdx2_quality_test.c \
            src/adpcm-dns.c \
            src/adpcm-lib.c \
            src/clamp.c \
            src/dpcm-xq-dns.c \
            src/dpcm-xq.c \
            src/sdx2_decode.c \
            src/sdx2_encode.c
TEST_ALLOC_FLAGS = -Dmalloc=codec_test_malloc -Dfree=codec_test_free
TEST_CPP_OUTPUT = build/parallel_test
TEST_CPP_SRCS = tests/parallel_test.cpp
SCORE_TEST_OUTPUT = build/encoder_score_test
SCORE_TEST_SRCS = tests/encoder_score_test.cpp src/encoder_score.cpp

TOOL_PREFIX := $(if $(COMPILER_PREFIX),$(COMPILER_PREFIX)-)
CC          := $(TOOL_PREFIX)gcc
CXX         := $(TOOL_PREFIX)g++
STRIP       := $(TOOL_PREFIX)strip

ifeq ($(NDEBUG),1)
OPT := -O3 -flto -static
MODE := release
else
OPT := -O0 -ggdb -ftrapv
MODE := debug
endif

ifeq ($(SANITIZE),1)
OPT += -fsanitize=address
MODE := $(MODE)-asan
endif

# std::thread needs the platform threading runtime; MinGW also needs its
# posix threads model.
THREAD_FLAGS = -pthread

CFLAGS = $(OPT) -Wall $(THREAD_FLAGS)
CXXFLAGS = $(OPT) -Wall -std=c++17 $(THREAD_FLAGS)
CPPFLAGS ?= -MMD -MP

SRCS_C   := $(wildcard src/*.c)
SRCS_CXX := $(wildcard src/*.cpp)

# Objects live under a per-mode directory: mixing sanitized and unsanitized
# objects in one place fails to link with unrelated-looking errors.
BUILDDIR = build/$(PLATFORM)/$(MODE)
OBJS := $(SRCS_C:src/%.c=$(BUILDDIR)/%.c.o)
OBJS += $(SRCS_CXX:src/%.cpp=$(BUILDDIR)/%.cpp.o)
DEPS  = $(OBJS:.o=.d)


all: $(OUTPUT)

$(OUTPUT): builddir $(OBJS)
	$(CXX) $(CXXFLAGS) -o $(OUTPUT) $(OBJS) $(LDFLAGS)

test: builddir
	$(CC) $(CFLAGS) $(TEST_ALLOC_FLAGS) -Isrc $(TEST_SRCS) -lm -o $(TEST_OUTPUT)
	$(TEST_OUTPUT)
	$(CXX) $(CXXFLAGS) -Isrc $(TEST_CPP_SRCS) -o $(TEST_CPP_OUTPUT)
	$(TEST_CPP_OUTPUT)
	$(CXX) $(CXXFLAGS) -Isrc $(SCORE_TEST_SRCS) -o $(SCORE_TEST_OUTPUT)
	$(SCORE_TEST_OUTPUT)

strip: $(OUTPUT)
	$(STRIP) --strip-all $(OUTPUT)

$(BUILDDIR)/%.c.o: src/%.c
	$(CC) $(CPPFLAGS) $(CFLAGS) -c $< -o $@

$(BUILDDIR)/%.cpp.o: src/%.cpp
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -c $< -o $@

clean:
	rm -rfv build/

builddir:
	mkdir -p $(BUILDDIR)
	cp license.txt build/license.txt

release-base: clean
	$(MAKE) -f Makefile NDEBUG=1 -j$(JOBS) strip
#	$(MAKE) -f Makefile.win32 NDEBUG=1 -j$(JOBS) strip
	$(MAKE) -f Makefile.win64 NDEBUG=1 -j$(JOBS) strip

release:
	docker run --rm -it -e PUID=$(PUID) -e PGID=$(PGID) -v ${PWD}:/src alpine:edge "/src/buildtools/docker-make-release"


.PHONY: all clean builddir docker-release release release-base strip test

-include $(DEPS)
